# ==========================================
# 1. ADMIN AUTHENTICATION (Single Owner)
# ==========================================
# The single email address permitted to log into the admin portal (/admin)
AUTH_EMAIL=admin@example.com

# The single secure password for the admin account (keep private, verified server-side only)
AUTH_PASSWORD=admin

# A random 32+ character secret string used to sign session cookies securely
# (e.g. generate via: openssl rand -base64 32)
AUTH_SECRET=4a9f8b1c7e2d6a5f0e3b9c8d1f4a7b2e6c5d9f0a3e8b7c1d4e6f9a2b5c8e1d3f

# ==========================================
# 2. PRIMARY SITE CONFIGURATION
# ==========================================
# The full public URL of your website (used for SEO canonicals, sitemaps, and origin checks).
# In production on Vercel, set this to your custom domain (or your vercel.app domain).
NEXT_PUBLIC_SITE_URL=https://www.ikhtiyaar.com

# ==========================================
# 2. DATABASE CONFIGURATION (Neon PostgreSQL)
# ==========================================
# Your pooled PostgreSQL connection string from Neon Console (Dashboard -> Connection Details).
# Always ensure sslmode=require is enabled.
DATABASE_URL=postgresql://neondb_owner:npg_Ys9qGgl2vdcM@ep-lingering-butterfly-b460477u-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ==========================================
# 3. FILE / IMAGE STORAGE (UploadThing)
# ==========================================
# API Token from your UploadThing Dashboard (Dashboard -> API Keys).
# UploadThing v7+ uses this single unified token for authentication.
UPLOADTHING_TOKEN='eyJhcGlLZXkiOiJza19saXZlXzc3YWY2OGM3MDllNGNiMzU2OGQxMWJkNTFiNWFhYmM2NTg5MWY2MWMwZDA0OTBmZTI4ZDY1YjkzOTI4OGQ1MzgiLCJhcHBJZCI6Inoxa2xsbms5Y3YiLCJyZWdpb25zIjpbInNlYTEiXX0='

# (Optional: Only if using an older UploadThing v6 setup instead of UPLOADTHING_TOKEN)
# UPLOADTHING_SECRET=sk_live_...
# UPLOADTHING_APP_ID=your_app_id_here

# ==========================================
# 4. EXTERNAL SERVICES & INTEGRATIONS
# ==========================================
# (Optional) Destination endpoint where contact form inquiries are forwarded.
# Currently defaults in code to: https://ikhtiyaarbackend.vercel.app/api/contact
# CONTACT_API_URL=https://ikhtiyaarbackend.vercel.app/api/contact

# ==========================================
# 5. LEGACY / LOCAL HOSTINGER VPS (NOT needed on Vercel)
# ==========================================
# Path to local persistent folder (only used by the legacy SQLite/local media adapter on a VPS).
# When using Neon and UploadThing on Vercel, this variable is not used.
# IKHTIYAAR_DATA_DIR=/var/lib/ikhtiyaar
